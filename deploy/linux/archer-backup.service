[Unit]
Description=Encrypted Archer state backup
[Service]
Type=oneshot
EnvironmentFile=/etc/archer/backup.env
ExecStart=/usr/bin/restic backup /var/lib/archer/core --tag archer-core
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CacheDirectory=archer-backup
Environment=RESTIC_CACHE_DIR=/var/cache/archer-backup
