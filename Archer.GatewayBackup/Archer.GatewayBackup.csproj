<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Archer.GatewayBackup</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the EXACT authenticated encryption format from the gateway.
         No reference to the ASP.NET app, its APIs or model credentials. -->
    <Compile Include="../Archer.MobileGateway/GatewayStateEncryption.cs"
             Link="GatewayStateEncryption.cs" />
  </ItemGroup>
</Project>
